{
  "name": "karyasetu/enterprise-platform",
  "description": "Karyasetu Enterprise Platform - inventory, purchasing, and accounting",
  "require": {
    "php": ">=8.1",
    "ext-mysqli": "*",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
